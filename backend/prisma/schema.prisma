// PayFlex app database schema.
//
// Phase 1: local user record (mirroring the BMONI user + owner wallet),
// smart wallets provisioned for that user, and raw webhook events.
// Phase 2 adds KycProfile (local mirror of KYC submission progress — the
// actual documents/decisions live in BMONI, this just tracks what we've
// submitted so the wizard UI can resume) and RailOnboarding (per-currency
// onboarding state for NGN/USD). Phase 3 adds PayTag and TransferProposal.
// Phase 4 adds the microfinance layer (SavingsGoal/SavingsContribution,
// LoanApplication/LoanRepayment, AgentTransaction) — see the comment
// above those models for why they're pure app-layer, no BMONI
// equivalent. Phase 5 adds split bills (SplitBill/SplitBillContributor)
// and the send-via-link escrow ledger (ClaimableLink) — see the comment
// above ClaimableLink in particular before touching that table; it's a
// real liability surface, not just a data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id            String   @id @default(uuid())
  bmoniUserId   String   @unique
  firstName     String
  lastName      String
  email         String
  phoneNumber   String   @unique

  // Public EVM address of the on-device owner wallet generated by
  // bmoni_embedded_sdk. The private key never leaves the device and is
  // never stored here or anywhere else server-side.
  ownerAddress  String?

  // Agent mode (Phase 4) — a regular AppUser flagged to run cash-in/
  // cash-out for other users. Not a separate account type; any user can
  // become an agent (see AgentService.setAgentStatus).
  isAgent       Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  smartWallets       SmartWallet[]
  webhookEvents      WebhookEvent[]
  kycProfile         KycProfile?
  railOnboardings    RailOnboarding[]
  payTag             PayTag?
  transferProposals  TransferProposal[]
  savingsGoals       SavingsGoal[]
  loanApplications   LoanApplication[]
  agentTransactionsAsAgent    AgentTransaction[] @relation("AgentTransactionsAsAgent")
  agentTransactionsAsCustomer AgentTransaction[] @relation("AgentTransactionsAsCustomer")
  splitBillsCreated           SplitBill[]
  splitBillContributions      SplitBillContributor[]
  claimableLinksSent          ClaimableLink[]         @relation("ClaimableLinksSent")
  claimableLinksClaimed       ClaimableLink[]         @relation("ClaimableLinksClaimed")
}

model SmartWallet {
  id            String   @id @default(uuid())
  appUserId     String
  appUser       AppUser  @relation(fields: [appUserId], references: [id])

  bmoniWalletId String   @unique

  // Stablecoin code as used by BMONI's smart-wallet endpoints, NOT the
  // fiat code: USDB, CNGN, CADC, EURe, GBPe, MEXe.
  currency      String
  address       String?
  status        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([appUserId, currency])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  appUserId   String?
  appUser     AppUser?  @relation(fields: [appUserId], references: [id])
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// Local mirror of KYC submission progress. BMONI is the source of truth
// for whether documents/decisions are actually valid (see kyc/readiness,
// kyc/usd-readiness) — this table exists so the wizard UI can resume
// where a user left off without re-querying BMONI on every screen, and so
// we can record which currencies have actually been through
// POST /kyc/activate (KYC data is shared across currencies, but
// activation is per rail — see build brief section 2.2).
model KycProfile {
  id        String  @id @default(uuid())
  appUserId String  @unique
  appUser   AppUser @relation(fields: [appUserId], references: [id])

  personalInfo           Json?
  address                Json?
  employment             Json?
  sourceOfFunds          String?
  accountPurpose         String?
  estimatedMonthlyVolume Int?

  identificationSubmittedAt DateTime?
  proofOfAddressSubmittedAt DateTime?
  biometricSubmittedAt      DateTime?
  readyAt                   DateTime?

  // Currencies for which POST /kyc/activate has succeeded.
  activatedCurrencies String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-currency rail onboarding state (NGN/USD in Phase 2; CAD/EUR/MXN
// stubs land in Phase 5). `status` is our own coarse label, not a literal
// copy of BMONI's per-provider onboarding/status fields (anchorStatus,
// bridgeStatus, ...) — see OnboardingService for the mapping.
model RailOnboarding {
  id        String  @id @default(uuid())
  appUserId String
  appUser   AppUser @relation(fields: [appUserId], references: [id])

  currency   String
  status     String
  workflowId String?
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appUserId, currency])
}

// PayFlex's own @handle -> user directory. BMONI has no equivalent
// primitive (see build brief section 3) — every transfer that targets a
// PayTag resolves it to a bmoniUserId here first, then runs the normal
// TransferService flow.
model PayTag {
  id        String   @id @default(uuid())
  tag       String   @unique
  appUserId String   @unique
  appUser   AppUser  @relation(fields: [appUserId], references: [id])
  createdAt DateTime @default(now())
}

// Local mirror of a BMONI smart-wallet TRANSFER proposal. BMONI is the
// source of truth for proposal state (see TransferService.getProposal) —
// this table exists so the app can list "my transfers" without listing
// proposals per wallet on every screen, and so QR/PayTag/future
// split-bill flows have a local row to attach their own metadata to
// (e.g. which QR token produced this transfer).
model TransferProposal {
  id              String  @id @default(uuid())
  appUserId       String
  appUser         AppUser @relation(fields: [appUserId], references: [id])
  bmoniProposalId String  @unique
  smartWalletId   String
  toBmoniUserId   String?
  toAddress       String?
  amount          String
  currency        String
  status          String
  nextAction      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 4 — microfinance layer. Everything below is pure PayFlex
// invention (build brief section 3: BMONI has no savings/loan/agent
// primitives at all) built on top of the TransferService proposal flow.
//
// Savings goals: an app-level ledger, NOT an on-chain escrow — periodic
// contributions are ordinary signed TRANSFERs from the user's own wallet
// to PayFlex's treasury account (see src/treasury/). The scheduler below
// can only ever mark a contribution DUE; it cannot execute one, because
// BMONI's signing model ties every transfer to the sender's own
// on-device key — there is no delegated/pre-authorized debit mechanism.
// "Scheduled transfer jobs" in the brief means "the backend decides when
// a contribution is due and the app prompts the user to sign it next
// time they're in the app," not silent background execution.
model SavingsGoal {
  id        String  @id @default(uuid())
  appUserId String
  appUser   AppUser @relation(fields: [appUserId], references: [id])

  name               String
  currency           String
  targetAmount       String
  contributionAmount String
  frequency          String // "DAILY" | "WEEKLY" | "MONTHLY"
  nextContributionAt DateTime
  status             String @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  totalContributed   String @default("0")

  contributions SavingsContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavingsContribution {
  id            String      @id @default(uuid())
  savingsGoalId String
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id])

  amount          String
  status          String    @default("DUE") // DUE | PROPOSED | CONFIRMED | FAILED
  bmoniProposalId String?
  dueAt           DateTime
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Loans: LoanService scores an applicant purely off their BMONI
// transaction history (GET transactions/{smartWalletId}) via a pluggable
// CreditScoringStrategy — see src/loans/credit-scoring/. An approved
// loan disburses immediately because PayFlex's own treasury account
// signs the disbursement server-side (it's PayFlex's money moving under
// PayFlex's own authority, unlike every other transfer in this app,
// which requires the end user's live on-device signature).
model LoanApplication {
  id        String  @id @default(uuid())
  appUserId String
  appUser   AppUser @relation(fields: [appUserId], references: [id])

  requestedAmount        String
  currency               String
  status                 String  @default("PENDING") // PENDING | APPROVED | REJECTED | DISBURSED | REPAYING | CLOSED
  approvedAmount         String?
  creditScore            Int?
  scoringReasoning       Json?
  disbursementProposalId String?

  repayments LoanRepayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanRepayment {
  id                String          @id @default(uuid())
  loanApplicationId String
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id])

  amount          String
  dueAt           DateTime
  status          String    @default("DUE") // DUE | PROPOSED | PAID
  bmoniProposalId String?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Agent mode: cash-in (agent's wallet -> customer's wallet, agent
// received physical cash) and cash-out (customer's wallet -> agent's
// wallet, agent hands over physical cash) are ordinary TransferService
// transfers — this table exists purely so an agent has their own
// reconciliation ledger distinct from a regular user's transaction list.
model AgentTransaction {
  id String @id @default(uuid())

  agentAppUserId String
  agent          AppUser @relation("AgentTransactionsAsAgent", fields: [agentAppUserId], references: [id])

  customerAppUserId   String?
  customer            AppUser? @relation("AgentTransactionsAsCustomer", fields: [customerAppUserId], references: [id])
  customerBmoniUserId String

  type            String // "CASH_IN" | "CASH_OUT"
  amount          String
  currency        String
  bmoniProposalId String
  status          String @default("PENDING")

  createdAt DateTime @default(now())
}

// Phase 5 — split-bill (build brief section 4.3): orchestration only.
// BMONI has no group-payment primitive, so this is a plain PayFlex table
// tracking who owes what; each contributor's payment is an entirely
// independent TransferService proposal signed by that contributor, same
// as any other transfer. A shared, HMAC-signed QR (HmacTokenService)
// carries the splitBillId so a scanning contributor's app can look up
// their own share.
model SplitBill {
  id              String  @id @default(uuid())
  creatorAppUserId String
  creator         AppUser @relation(fields: [creatorAppUserId], references: [id])

  description   String
  currency      String
  totalAmount   String
  status        String @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED

  contributors SplitBillContributor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SplitBillContributor {
  id          String    @id @default(uuid())
  splitBillId String
  splitBill   SplitBill @relation(fields: [splitBillId], references: [id])

  appUserId       String
  appUser         AppUser @relation(fields: [appUserId], references: [id])
  shareAmount     String
  status          String  @default("PENDING") // PENDING | PROPOSED | PAID
  bmoniProposalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([splitBillId, appUserId])
}

// Phase 5 — send-via-link (build brief section 4.4 / section 3): BMONI
// has NO claimable-balance primitive. When the recipient doesn't have a
// bmoniUserId yet, funds are held in PayFlex's own treasury account (the
// same one loan disbursement uses — see src/treasury/) until the
// recipient completes onboarding and claims them.
//
// *** LIABILITY / COMPLIANCE NOTE (per the build brief, not to be
// implemented quietly): while a link is ESCROWED, PayFlex is holding a
// real customer's funds in its own custodial account — this is PayFlex
// becoming a money holder for that balance, not just a technical relay.
// A real deployment needs to treat every ESCROWED ClaimableLink as
// PayFlex-held customer liability on its books (reconciled, insured,
// disclosed per applicable e-money/custody regulation in whatever
// jurisdiction it operates) for as long as it sits unclaimed — this
// table is not a substitute for that compliance work, only the ledger
// it would be built on top of. See README "Send-via-link is a real
// liability surface" for the full writeup. ***
model ClaimableLink {
  id     String  @id @default(uuid())
  senderAppUserId String
  sender AppUser @relation("ClaimableLinksSent", fields: [senderAppUserId], references: [id])

  amount   String
  currency String
  status   String @default("PENDING_ESCROW") // PENDING_ESCROW | ESCROWED | CLAIMED | EXPIRED

  escrowProposalId  String? // sender's wallet -> treasury
  releaseProposalId String? // treasury -> claimant's wallet

  claimedByAppUserId String?
  claimedBy          AppUser? @relation("ClaimableLinksClaimed", fields: [claimedByAppUserId], references: [id])
  claimedAt          DateTime?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
