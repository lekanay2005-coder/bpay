// PayFlex app database schema.
//
// Phase 1 scope only: local user record (mirroring the BMONI user + owner
// wallet), smart wallets provisioned for that user, and raw webhook events.
// Later phases add PayTag directory, savings goals, loans, split bills, and
// escrow tables — do not add them here ahead of the phase that needs them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id            String   @id @default(uuid())
  bmoniUserId   String   @unique
  firstName     String
  lastName      String
  email         String
  phoneNumber   String   @unique

  // Public EVM address of the on-device owner wallet generated by
  // bmoni_embedded_sdk. The private key never leaves the device and is
  // never stored here or anywhere else server-side.
  ownerAddress  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  smartWallets  SmartWallet[]
  webhookEvents WebhookEvent[]
}

model SmartWallet {
  id            String   @id @default(uuid())
  appUserId     String
  appUser       AppUser  @relation(fields: [appUserId], references: [id])

  bmoniWalletId String   @unique

  // Stablecoin code as used by BMONI's smart-wallet endpoints, NOT the
  // fiat code: USDB, CNGN, CADC, EURe, GBPe, MEXe.
  currency      String
  address       String?
  status        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([appUserId, currency])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  appUserId   String?
  appUser     AppUser?  @relation(fields: [appUserId], references: [id])
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}
