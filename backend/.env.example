# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# --- BMONI Embedded API -----------------------------------------------------
# Base URLs are ORIGIN ONLY. Every BMONI path constant in src/bmoni already
# starts with "/v1/" — do NOT append "/v1" here, or you will get "/v1/v1/..."
# 404s. This is the single most common integration mistake with this API.
BMONI_BASE_URL_SANDBOX=https://embedded-dev.bmoni.com
BMONI_BASE_URL_PRODUCTION=https://embedded.bmoni.com

# Sandbox key is safe to use for all local dev/testing.
BMONI_API_KEY_SANDBOX=pk_a025cacbf33a_76fb864113f3540909de5b1da39cc146906e35b1c6d4d1e4

# There is no production key yet. Request one from developers@bkey.me before
# a production launch, then set it here (in real deployment secrets, not in
# a committed file). Leave blank in dev.
BMONI_API_KEY_PRODUCTION=

# Which BMONI environment this service talks to: "sandbox" | "production"
BMONI_ENV=sandbox

# --- App database ------------------------------------------------------------
DATABASE_URL=postgresql://payflex:payflex@localhost:5432/payflex?schema=public

# --- Cache/session ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Webhooks -----------------------------------------------------------------
# Shared secret BMONI signs webhook payloads with, if/when they provide one.
# Left blank until BMONI's webhook signing scheme is confirmed; the receiver
# logs a warning and accepts unsigned payloads in that case (sandbox only).
BMONI_WEBHOOK_SECRET=

# --- QR Pay (Phase 3, app-layer only — nothing to do with BMONI signing) -----
# HMAC secret used to sign short-lived QR Pay tokens so they can't be
# tampered with in transit. Any long random string; rotate freely (it only
# invalidates in-flight, unscanned QR codes). Generate one with:
#   openssl rand -hex 32
QR_SIGNING_SECRET=dev-only-insecure-secret-change-me
