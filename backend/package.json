{
  "name": "payflex-backend",
  "version": "0.1.0",
  "description": "PayFlex orchestration backend — NestJS service sitting between the Flutter app and the BMONI Embedded API.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "sandbox:lifecycle": "ts-node -r tsconfig-paths/register scripts/sandbox-lifecycle.ts",
    "sandbox:phase2": "ts-node -r tsconfig-paths/register scripts/sandbox-lifecycle-phase2.ts",
    "sandbox:kyc-mismatch": "ts-node -r tsconfig-paths/register scripts/kyc-bvn-mismatch-check.ts",
    "sandbox:phase3": "ts-node -r tsconfig-paths/register scripts/sandbox-lifecycle-phase3.ts",
    "sandbox:phase4": "ts-node -r tsconfig-paths/register scripts/sandbox-lifecycle-phase4.ts",
    "sandbox:phase5": "ts-node -r tsconfig-paths/register scripts/sandbox-lifecycle-phase5.ts",
    "provision:treasury": "ts-node -r tsconfig-paths/register scripts/provision-treasury.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ethers": "^6.13.2",
    "form-data": "^4.0.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
